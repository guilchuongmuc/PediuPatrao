# Copie este arquivo para "application-local.properties" (ignorado pelo git) e preencha.
# Alternativa: definir as variáveis de ambiente MONGODB_URI e MONGODB_DATABASE.

# URI de conexão do MongoDB (Atlas ou local)
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster0.exemplo.mongodb.net/?appName=Cluster0

# Nome do banco usado por este projeto
MONGODB_DATABASE=pediupatrao

# (Opcional) senha inicial dos usuários admin, gerente e atendente criados na primeira execução
# APP_SEED_SENHA=TroqueEstaSenha@2026
